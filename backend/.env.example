PORT=5000
NODE_ENV=development

# MongoDB — Atlas connection string (put db name in the path)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mod-u-go?appName=cse-placements

# Firebase Admin (service account) — from Firebase console → Project settings → Service accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Secret used to sign student roster-login JWTs. REQUIRED for any real run
# (local dev included): without it a random ephemeral secret is generated per
# process and every restart invalidates all student sessions.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
STUDENT_JWT_SECRET=replace-me-with-a-long-random-hex-string
# Optional: how long student login tokens stay valid (default 12h)
# STUDENT_TOKEN_TTL=12h

# CORS — allowed frontend origin(s); comma-separate multiple
FRONTEND_URL=http://localhost:5173

# Set to 1 when running behind a proxy (Render/Vercel/Nginx) so rate limiting
# sees real client IPs
TRUST_PROXY=

# Cloudinary — question image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
